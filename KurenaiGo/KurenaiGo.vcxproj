  <!--
    出力先は本リポジトリ自身のBuild\Bin配下(KurenaiEngineとは独立)。実行に必要なもの
    (KurenaiEngineLibrary.dll/KurenaiEngine2D.dll、Shaders\、Assets\の効果音、KataGo\のKataGo本体)は
    すべてPostBuildEventで実行ファイルと同じフォルダへ集約する(PathUtil::ResolveAppDataPathも参照)。
    これによりBuild\Bin\<Platform>\<Config>\ フォルダごとコピーするだけで動作する。KurenaiEngineは
    共通基盤(KurenaiEngineLibrary)と3D/2D(KurenaiEngine3D/KurenaiEngine2D)の3DLLに分割されており、
    2D専用アプリであるKurenaiGoはLibraryと2Dの2つのみを使用する(3D用DLL・Assetsは同梱不要)。
    KurenaiEngine2Dはシェーダファイルを自身のDLLフォルダ基準(GetModuleHandleExWでDLL自身の
    モジュールを取得)で解決するため、KurenaiEngine2D.dllをコピーする際にShadersフォルダも
    一緒にKurenaiGoのOutDirへコピーする必要がある。石・格子線・星はDrawCircle/DrawLineで
    直接描画するためテクスチャは使用していないが、効果音(WAV)はTools/generate_sound_effects.ps1で
    生成しAssets\Sounds\にコミットしている。
  -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutDir>$(SolutionDir)Build\Bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)Build\Intermediate\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(SolutionDir)Build\Bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)Build\Intermediate\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;UNICODE;_UNICODE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(SolutionDir)KurenaiEngine\KurenaiEngine\Source\Engine;$(SolutionDir)KurenaiEngine\KurenaiEngine\Source\Library;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <PostBuildEvent>
      <Command>set KURENAI_BIN=$(SolutionDir)KurenaiEngine\Build\Bin\$(Platform)\$(Configuration)
xcopy /Y /D "%KURENAI_BIN%\KurenaiEngineLibrary\*.dll" "$(OutDir)"
xcopy /Y /D "%KURENAI_BIN%\KurenaiEngineLibrary\*.pdb" "$(OutDir)"
xcopy /Y /D "%KURENAI_BIN%\KurenaiEngine2D\*.dll" "$(OutDir)"
xcopy /Y /D "%KURENAI_BIN%\KurenaiEngine2D\*.pdb" "$(OutDir)"
xcopy /E /I /Y /D "%KURENAI_BIN%\KurenaiEngine2D\Shaders" "$(OutDir)Shaders"
xcopy /E /I /Y /D "$(ProjectDir)Assets" "$(OutDir)Assets"
if not exist "$(OutDir)KataGo" mkdir "$(OutDir)KataGo"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;UNICODE;_UNICODE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(SolutionDir)KurenaiEngine\KurenaiEngine\Source\Engine;$(SolutionDir)KurenaiEngine\KurenaiEngine\Source\Library;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
    <PostBuildEvent>
      <Command>set KURENAI_BIN=$(SolutionDir)KurenaiEngine\Build\Bin\$(Platform)\$(Configuration)
xcopy /Y /D "%KURENAI_BIN%\KurenaiEngineLibrary\*.dll" "$(OutDir)"
xcopy /Y /D "%KURENAI_BIN%\KurenaiEngineLibrary\*.pdb" "$(OutDir)"
xcopy /Y /D "%KURENAI_BIN%\KurenaiEngine2D\*.dll" "$(OutDir)"
xcopy /Y /D "%KURENAI_BIN%\KurenaiEngine2D\*.pdb" "$(OutDir)"
xcopy /E /I /Y /D "%KURENAI_BIN%\KurenaiEngine2D\Shaders" "$(OutDir)Shaders"
xcopy /E /I /Y /D "$(ProjectDir)Assets" "$(OutDir)Assets"
if not exist "$(OutDir)KataGo" mkdir "$(OutDir)KataGo"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
