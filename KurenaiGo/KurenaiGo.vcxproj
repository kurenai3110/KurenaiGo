  <!--
    出力先は本リポジトリ自身のBuild\Bin配下(KurenaiEngineとは独立)。実行に必要なもの
    (KurenaiEngine.dll、Shaders\、Assets\の石テクスチャ、KataGo\のKataGo本体)はすべて
    PostBuildEventで実行ファイルと同じフォルダへ集約する(PathUtil::ResolveAppDataPathも参照)。
    これによりBuild\Bin\<Platform>\<Config>\ フォルダごとコピーするだけで動作する。
    KurenaiEngine2D/3DはシェーダファイルをKurenaiEngine.dll自身のフォルダ基準
    (GetModuleHandleExWでDLL自身のモジュールを取得)で解決するため、KurenaiEngine.dllを
    コピーする際にShadersフォルダも一緒にKurenaiGoのOutDirへコピーする必要がある。
  -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutDir>$(SolutionDir)Build\Bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)Build\Intermediate\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(SolutionDir)Build\Bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)Build\Intermediate\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;UNICODE;_UNICODE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(SolutionDir)KurenaiEngine\KurenaiEngine\Source\Engine;$(SolutionDir)KurenaiEngine\KurenaiEngine\Source\Library;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <PostBuildEvent>
      <Command>xcopy /Y /D "$(SolutionDir)KurenaiEngine\Build\Bin\$(Platform)\$(Configuration)\KurenaiEngine.dll" "$(OutDir)"
xcopy /Y /D "$(SolutionDir)KurenaiEngine\Build\Bin\$(Platform)\$(Configuration)\KurenaiEngine.pdb" "$(OutDir)"
xcopy /E /I /Y /D "$(SolutionDir)KurenaiEngine\Build\Bin\$(Platform)\$(Configuration)\Shaders" "$(OutDir)Shaders"
xcopy /E /I /Y /D "$(ProjectDir)Assets" "$(OutDir)Assets"
if not exist "$(OutDir)KataGo" mkdir "$(OutDir)KataGo"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
